DATABASE_URL="postgresql://aulera:aulera@localhost:5432/aulera"
DIRECT_URL="postgresql://aulera:aulera@localhost:5432/aulera"

AUTH_SECRET="replace-with-a-long-random-string"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# Supabase Storage — required in production (Vercel's filesystem is read-only,
# so Documentos/Recursos uploads need real object storage). Optional locally:
# without these, uploads fall back to ./uploads on local disk.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="aulera-uploads"
