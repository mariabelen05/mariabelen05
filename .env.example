DATABASE_URL="postgresql://aulera:aulera@localhost:5432/aulera"
DIRECT_URL="postgresql://aulera:aulera@localhost:5432/aulera"

AUTH_SECRET="replace-with-a-long-random-string"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"

# Supabase Storage — required in production (Vercel's filesystem is read-only,
# so Documentos/Recursos uploads need real object storage). Optional locally:
# without these, uploads fall back to ./uploads on local disk.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="aulera-uploads"

# Same Supabase project as above, but the public URL + anon key (safe to expose
# to the browser — Supabase's anon key is rate-limited/RLS-scoped, not a
# secret). These let Documentos/Recursos upload files straight from the
# browser to Storage with a signed URL, bypassing Vercel's ~4.5MB Serverless
# Function payload limit. Optional: without them uploads still work, just
# routed through the server with the lower MAX_UPLOAD_BYTES ceiling
# (src/lib/upload-limits.ts).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
